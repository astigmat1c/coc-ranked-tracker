# ---------------------------------------------------------------------------
# Supercell API
# ---------------------------------------------------------------------------
# Create a key at https://developer.clashofclans.com.
# Using the RoyaleAPI proxy (default): whitelist the key to 45.79.218.79.
# Running from your own fixed-IP host: whitelist that IP and set
#   COC_API_BASE=https://api.clashofclans.com/v1
COC_API_TOKEN=
COC_API_BASE=https://cocproxy.royaleapi.dev/v1

# Parallel in-flight requests. 10 is comfortably under the observed ceiling.
COC_CONCURRENCY=10

# Comma-separated league TIER ids to capture, from /leaguetiers:
#   105000034 Legend III, 105000035 Legend II, 105000036 Legend I
# Leave unset to track all three. Note these are tiers, not the legacy /leagues
# ids — the legacy league now reports "Unranked" on every live row.
TRACKED_LEAGUE_IDS=105000035

# How many clans the weekly sweep reads. ~525 Legend II players per 1,000 clans
# measured, so 20,000 finds roughly 10,000 and takes about 11 minutes.
MAX_CLANS=20000

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# The two NEXT_PUBLIC_ values ship to the browser — that is fine, they are
# read-only under RLS. The service-role key must never reach the client or git.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
